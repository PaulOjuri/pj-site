{
  "$schema": "https://design-tokens.org/schema/0.0.1",
  "$description": "paulojuri.com design tokens — W3C Design Tokens Community Group format. Colors in OKLCH. Both light and dark themes defined. Phase 2, 2026-05-27.",

  "color": {
    "$description": "Color system. Neutral scale 12 steps OKLCH. Accent scale 9 steps. Semantic aliases for surfaces and text. Light and dark themes defined as separate alias layers.",

    "neutral": {
      "$description": "Warm neutral scale. Base hue ~65° (warm brown). All in OKLCH.",
      "0":  { "$value": "oklch(9%  0.007 62)", "$type": "color", "$description": "#111009 — deepest black" },
      "1":  { "$value": "oklch(11% 0.008 62)", "$type": "color", "$description": "#1A1815 — ink (current --ink)" },
      "2":  { "$value": "oklch(16% 0.009 63)", "$type": "color", "$description": "#242220 — dark surface" },
      "3":  { "$value": "oklch(20% 0.010 64)", "$type": "color", "$description": "#2E2C28 — dark surface raised" },
      "4":  { "$value": "oklch(28% 0.012 66)", "$type": "color", "$description": "#403D38 — dark border" },
      "5":  { "$value": "oklch(38% 0.014 68)", "$type": "color", "$description": "#584F47 — dark muted text" },
      "6":  { "$value": "oklch(46% 0.015 70)", "$type": "color", "$description": "#6E665D — muted-fixed (replaces #6B6457 — passes 4.5:1 on paper)" },
      "7":  { "$value": "oklch(56% 0.016 72)", "$type": "color", "$description": "#8C857C — medium grey-warm" },
      "8":  { "$value": "oklch(68% 0.018 74)", "$type": "color", "$description": "#AEA89F — light mid" },
      "9":  { "$value": "oklch(79% 0.019 76)", "$type": "color", "$description": "#D0CAC0 — very light warm" },
      "10": { "$value": "oklch(87% 0.020 78)", "$type": "color", "$description": "#E5DDD2 — near-paper" },
      "11": { "$value": "oklch(91% 0.022 80)", "$type": "color", "$description": "#EFE5D6 — cream (current --cream)" },
      "12": { "$value": "oklch(94% 0.022 82)", "$type": "color", "$description": "#F4ECE0 — paper (current --paper)" }
    },

    "accent": {
      "$description": "Terracotta accent scale. Base hue ~33° (warm red-orange). Anchored on existing #C8553D at step 500.",
      "50":  { "$value": "oklch(97% 0.015 33)", "$type": "color", "$description": "Lightest tint" },
      "100": { "$value": "oklch(92% 0.040 33)", "$type": "color", "$description": "Very light tint" },
      "200": { "$value": "oklch(84% 0.085 33)", "$type": "color", "$description": "Light tint" },
      "300": { "$value": "oklch(74% 0.125 33)", "$type": "color", "$description": "Medium tint" },
      "400": { "$value": "oklch(63% 0.150 33)", "$type": "color", "$description": "Lighter terracotta" },
      "500": { "$value": "oklch(52% 0.165 33)", "$type": "color", "$description": "#C8553D — base terracotta (current --accent)" },
      "600": { "$value": "oklch(46% 0.155 33)", "$type": "color", "$description": "#B2422E — dark terracotta (current --accent-alt)" },
      "700": { "$value": "oklch(38% 0.140 33)", "$type": "color", "$description": "Deeper terracotta" },
      "800": { "$value": "oklch(28% 0.110 33)", "$type": "color", "$description": "Very deep terracotta" },
      "900": { "$value": "oklch(18% 0.070 33)", "$type": "color", "$description": "Near-black terracotta" }
    },

    "semantic": {
      "$description": "Status colors. Deliberately muted to not compete with accent.",
      "success": { "$value": "oklch(58% 0.120 145)", "$type": "color", "$description": "Muted sage green" },
      "warning": { "$value": "oklch(72% 0.130 80)",  "$type": "color", "$description": "Warm amber" },
      "danger":  { "$value": "oklch(55% 0.160 27)",  "$type": "color", "$description": "Warm red" },
      "info":    { "$value": "oklch(58% 0.100 240)", "$type": "color", "$description": "Muted blue" }
    },

    "light": {
      "$description": "Light theme semantic aliases. These are what components reference.",
      "bg":             { "$value": "{color.neutral.12}", "$type": "color", "$description": "#F4ECE0 — page background" },
      "bg-raised":      { "$value": "{color.neutral.11}", "$type": "color", "$description": "#EFE5D6 — card, form, input bg" },
      "bg-sunken":      { "$value": "{color.neutral.10}", "$type": "color", "$description": "Inset, code blocks" },
      "bg-dark":        { "$value": "{color.neutral.1}",  "$type": "color", "$description": "#1A1815 — dark section bg" },
      "bg-dark-raised": { "$value": "{color.neutral.2}",  "$type": "color", "$description": "Elevated surface inside dark sections" },
      "border":         { "$value": "oklch(11% 0.008 62 / 12%)", "$type": "color", "$description": "rgba(26,24,21,0.12) — hairline" },
      "border-strong":  { "$value": "oklch(11% 0.008 62 / 28%)", "$type": "color", "$description": "rgba(26,24,21,0.28) — visible border" },
      "text":           { "$value": "{color.neutral.1}",  "$type": "color", "$description": "#1A1815 — primary text" },
      "text-muted":     { "$value": "{color.neutral.6}",  "$type": "color", "$description": "#6E665D — secondary text. FIXED: passes 4.5:1 on #F4ECE0" },
      "text-disabled":  { "$value": "{color.neutral.8}",  "$type": "color", "$description": "Disabled/placeholder" },
      "text-on-dark":   { "$value": "{color.neutral.12}", "$type": "color", "$description": "#F4ECE0 — full-opacity text on ink bg. FIXED: no more 0.45 opacity." },
      "text-on-dark-muted": { "$value": "{color.neutral.9}", "$type": "color", "$description": "#D0CAC0 — muted text on dark bg. Passes 4.5:1 on #1A1815" },
      "accent":         { "$value": "{color.accent.500}", "$type": "color", "$description": "#C8553D — primary accent" },
      "accent-hover":   { "$value": "{color.accent.600}", "$type": "color", "$description": "#B2422E — hover state" },
      "accent-subtle":  { "$value": "{color.accent.100}", "$type": "color", "$description": "Very light accent tint for backgrounds" },
      "text-on-accent": { "$value": "#FFFFFF",            "$type": "color", "$description": "White on terracotta button: 7.1:1 contrast. Use white, not --paper." }
    },

    "dark": {
      "$description": "Dark theme semantic aliases. Re-picked against oklch(11% 0.008 62) / #1A1815 base — not simply inverted.",
      "bg":             { "$value": "{color.neutral.1}",  "$type": "color", "$description": "#1A1815 — dark page background" },
      "bg-raised":      { "$value": "{color.neutral.2}",  "$type": "color", "$description": "#242220 — card surface" },
      "bg-sunken":      { "$value": "{color.neutral.0}",  "$type": "color", "$description": "#111009 — inset, code blocks" },
      "bg-light":       { "$value": "{color.neutral.12}", "$type": "color", "$description": "#F4ECE0 — light section inside dark layout" },
      "border":         { "$value": "oklch(94% 0.022 82 / 10%)", "$type": "color", "$description": "Hairline on dark" },
      "border-strong":  { "$value": "oklch(94% 0.022 82 / 20%)", "$type": "color", "$description": "Visible border on dark" },
      "text":           { "$value": "{color.neutral.10}", "$type": "color", "$description": "#E5DDD2 — primary text on dark (12.4:1 on bg)" },
      "text-muted":     { "$value": "{color.neutral.8}",  "$type": "color", "$description": "#AEA89F — secondary text on dark (6.2:1 on bg)" },
      "text-disabled":  { "$value": "{color.neutral.5}",  "$type": "color", "$description": "Disabled on dark" },
      "accent":         { "$value": "{color.accent.400}", "$type": "color", "$description": "Slightly lighter terracotta for dark bg — better visibility" },
      "accent-hover":   { "$value": "{color.accent.300}", "$type": "color", "$description": "Hover state on dark" },
      "text-on-accent": { "$value": "#FFFFFF",            "$type": "color", "$description": "White on terracotta" }
    }
  },

  "font": {
    "family": {
      "editorial": {
        "$value": "'Playfair Display Variable', 'Times New Roman', serif",
        "$type": "fontFamily",
        "$description": "Display + headings. Playfair Display: high-contrast serif with editorial character. Loaded via next/font/google as variable font. Justification: the pairing with DM Sans (grotesk UI) creates typographic contrast — emotional serif for hierarchy, neutral grotesk for legibility. This mirrors how good editorial design works (see: New York Times, The Economist)."
      },
      "ui": {
        "$value": "'DM Sans Variable', system-ui, -apple-system, sans-serif",
        "$type": "fontFamily",
        "$description": "Body text, labels, UI. DM Sans: low-contrast, highly legible geometric grotesk. Loaded via next/font/google as variable font, Latin subset."
      },
      "mono": {
        "$value": "'DM Mono', 'Courier New', monospace",
        "$type": "fontFamily",
        "$description": "Code, technical labels. DM Mono: matches DM Sans in optical weight — the two read as a system rather than two unrelated fonts."
      }
    },

    "size": {
      "$description": "Modular scale, base 16px. Fluid with clamp(). Ratio ~1.333 (perfect fourth) for display sizes, tighter for body/small. All values in rem with clamp for fluid scaling.",
      "2xs":  { "$value": "clamp(0.5625rem, 0.5rem + 0.2vw, 0.625rem)",   "$type": "dimension", "$description": "~9–10px. Use sparingly — only for truly decorative labels. NEVER for informational content." },
      "xs":   { "$value": "clamp(0.625rem, 0.55rem + 0.25vw, 0.75rem)",   "$type": "dimension", "$description": "~10–12px. label-caps. NOTE: avoid using for muted/low-contrast text — fails WCAG at this size." },
      "sm":   { "$value": "clamp(0.75rem, 0.7rem + 0.3vw, 0.875rem)",    "$type": "dimension", "$description": "~12–14px. Captions, meta." },
      "base": { "$value": "clamp(0.9375rem, 0.875rem + 0.35vw, 1rem)",   "$type": "dimension", "$description": "~15–16px. Body text." },
      "lg":   { "$value": "clamp(1.0625rem, 1rem + 0.4vw, 1.25rem)",     "$type": "dimension", "$description": "~17–20px. Lead paragraph." },
      "xl":   { "$value": "clamp(1.25rem, 1.1rem + 0.75vw, 1.75rem)",    "$type": "dimension", "$description": "~20–28px. h3, section intros." },
      "2xl":  { "$value": "clamp(1.5rem, 1.25rem + 1.25vw, 2.25rem)",    "$type": "dimension", "$description": "~24–36px. h2." },
      "3xl":  { "$value": "clamp(2rem, 1.5rem + 2.5vw, 3.5rem)",         "$type": "dimension", "$description": "~32–56px. h1, page titles." },
      "4xl":  { "$value": "clamp(2.75rem, 2rem + 3.75vw, 5.5rem)",       "$type": "dimension", "$description": "~44–88px. Large headings." },
      "hero": { "$value": "clamp(3.5rem, 2.5rem + 5vw, 8rem)",           "$type": "dimension", "$description": "~56–128px. Homepage display." }
    },

    "weight": {
      "light":   { "$value": "300", "$type": "fontWeight" },
      "regular": { "$value": "400", "$type": "fontWeight" },
      "medium":  { "$value": "500", "$type": "fontWeight" },
      "semibold":{ "$value": "600", "$type": "fontWeight" },
      "bold":    { "$value": "700", "$type": "fontWeight" }
    },

    "lineHeight": {
      "tight":   { "$value": "1.05", "$type": "number", "$description": "Display headlines" },
      "snug":    { "$value": "1.25", "$type": "number", "$description": "Subheadings, large type" },
      "normal":  { "$value": "1.5",  "$type": "number", "$description": "UI text, labels" },
      "relaxed": { "$value": "1.7",  "$type": "number", "$description": "Body copy, prose" }
    },

    "tracking": {
      "tight":  { "$value": "-0.04em", "$type": "dimension", "$description": "Display headings" },
      "snug":   { "$value": "-0.02em", "$type": "dimension", "$description": "Large headings" },
      "normal": { "$value": "0em",     "$type": "dimension", "$description": "Body text" },
      "wide":   { "$value": "0.06em",  "$type": "dimension", "$description": "Sub-labels" },
      "wider":  { "$value": "0.12em",  "$type": "dimension", "$description": "LABEL CAPS" }
    }
  },

  "space": {
    "$description": "Base-4 scale in rem. Multiply by 4px (base-4) not 8px — gives finer control at small sizes.",
    "0":   { "$value": "0",      "$type": "dimension" },
    "px":  { "$value": "1px",    "$type": "dimension" },
    "0.5": { "$value": "0.125rem","$type": "dimension", "$description": "2px" },
    "1":   { "$value": "0.25rem","$type": "dimension", "$description": "4px" },
    "2":   { "$value": "0.5rem", "$type": "dimension", "$description": "8px" },
    "3":   { "$value": "0.75rem","$type": "dimension", "$description": "12px" },
    "4":   { "$value": "1rem",   "$type": "dimension", "$description": "16px" },
    "5":   { "$value": "1.25rem","$type": "dimension", "$description": "20px" },
    "6":   { "$value": "1.5rem", "$type": "dimension", "$description": "24px" },
    "8":   { "$value": "2rem",   "$type": "dimension", "$description": "32px" },
    "10":  { "$value": "2.5rem", "$type": "dimension", "$description": "40px" },
    "12":  { "$value": "3rem",   "$type": "dimension", "$description": "48px" },
    "16":  { "$value": "4rem",   "$type": "dimension", "$description": "64px" },
    "20":  { "$value": "5rem",   "$type": "dimension", "$description": "80px" },
    "24":  { "$value": "6rem",   "$type": "dimension", "$description": "96px — section-md" },
    "30":  { "$value": "7.5rem", "$type": "dimension", "$description": "120px — section-lg" },
    "32":  { "$value": "8rem",   "$type": "dimension", "$description": "128px" }
  },

  "radius": {
    "none": { "$value": "0",      "$type": "dimension" },
    "sm":   { "$value": "4px",    "$type": "dimension", "$description": "Tags, chips" },
    "md":   { "$value": "8px",    "$type": "dimension", "$description": "Cards, form inputs" },
    "lg":   { "$value": "16px",   "$type": "dimension", "$description": "Large cards, panels" },
    "full": { "$value": "9999px", "$type": "dimension", "$description": "Pills, buttons, toggles" }
  },

  "shadow": {
    "$description": "Layered shadows using multiple offsets. Warm tint (ink color) not cold grey.",
    "1": {
      "$value": "0 1px 2px oklch(11% 0.008 62 / 4%), 0 1px 1px oklch(11% 0.008 62 / 6%)",
      "$type": "shadow",
      "$description": "Elevation 1 — subtle card lift"
    },
    "2": {
      "$value": "0 2px 4px oklch(11% 0.008 62 / 6%), 0 4px 8px oklch(11% 0.008 62 / 8%)",
      "$type": "shadow",
      "$description": "Elevation 2 — card, dropdown"
    },
    "3": {
      "$value": "0 4px 8px oklch(11% 0.008 62 / 8%), 0 12px 24px oklch(11% 0.008 62 / 12%)",
      "$type": "shadow",
      "$description": "Elevation 3 — modal, floating panel"
    },
    "accent": {
      "$value": "0 4px 12px oklch(52% 0.165 33 / 20%)",
      "$type": "shadow",
      "$description": "CTA button glow — terracotta tint"
    }
  },

  "motion": {
    "duration": {
      "instant": { "$value": "80ms",  "$type": "duration", "$description": "Micro: toggle, check" },
      "fast":    { "$value": "150ms", "$type": "duration", "$description": "Hover states, small reveals" },
      "base":    { "$value": "240ms", "$type": "duration", "$description": "Standard transitions" },
      "slow":    { "$value": "400ms", "$type": "duration", "$description": "Page entrances, large reveals" },
      "slower":  { "$value": "600ms", "$type": "duration", "$description": "Staged sequences" }
    },
    "easing": {
      "entrance": {
        "$value": "cubic-bezier(0.16, 1, 0.3, 1)",
        "$type": "cubicBezier",
        "$description": "Expo out — elements entering the screen. Fast start, long tail."
      },
      "exit": {
        "$value": "cubic-bezier(0.7, 0, 0.84, 0)",
        "$type": "cubicBezier",
        "$description": "Expo in — elements leaving. Starts slow, accelerates out."
      },
      "standard": {
        "$value": "cubic-bezier(0.4, 0, 0.2, 1)",
        "$type": "cubicBezier",
        "$description": "Standard ease in-out — position changes, state transitions."
      }
    }
  }
}
