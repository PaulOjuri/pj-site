# Security headers site-wide (previously only in vercel.json, which Cloudflare ignores).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Cross-origin isolation only where the multi-threaded engine runs. Everything else stays untouched.
/chess/train
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
/chess/train/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

/chess/engine/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
/chess/data/*
  Cache-Control: public, max-age=300

# The agent app (/app). Private: behind Cloudflare Access, never indexed, never cached by anything
# in between. The service worker claims the whole /app scope, which is above its own folder, so it
# needs Service-Worker-Allowed.
/app
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/app/sw.js
  Service-Worker-Allowed: /app
  Cache-Control: no-cache
  X-Robots-Tag: noindex, nofollow
/app/manifest.webmanifest
  Cache-Control: no-cache
  X-Robots-Tag: noindex, nofollow
/app/*
  X-Robots-Tag: noindex, nofollow
/api/app/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/api/agent/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
